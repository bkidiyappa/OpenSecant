# Application under test
OPENSECANT_BASE_URL=https://the-internet.herokuapp.com
OPENSECANT_EMAIL=tomsmith
OPENSECANT_PASSWORD=SuperSecretPassword!

# Runner
OPENSECANT_BROWSER=edge
OPENSECANT_NUM_WORKERS=2
HEADLESS=false
AI_HEALING_ENABLED=true

# LLM provider: bedrock | openai | ollama | azure
LLM_PROVIDER=ollama

# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# OpenAI (optional)
OPENAI_API_KEY=

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Ollama (optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Debug
DEBUG_PROMPTS=true
